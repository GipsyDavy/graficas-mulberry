<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gipsybuho.ui.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Iniciar Sesión" textFill="#333333">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>
    <Label text="Usuario:" textFill="#555555" />
    <ComboBox fx:id="userComboBox" promptText="Selecciona usuario" maxWidth="250.0" prefWidth="250.0" />
    <Label text="Contraseña:" textFill="#555555" />
    <PasswordField fx:id="passwordField" promptText="Introduce tu contraseña" maxWidth="250.0" />
    <TextField fx:id="visiblePasswordField" promptText="Introduce tu contraseña" maxWidth="250.0" managed="false" visible="false" />
    <CheckBox fx:id="showPasswordCheckBox" text="Mostrar contraseña" textFill="#555555" />
    <Button fx:id="loginButton" onAction="#handleLogin" text="Entrar" maxWidth="250.0">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Button>
    <Label fx:id="errorMessageLabel" textFill="RED">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>
</VBox>
